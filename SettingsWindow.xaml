<Window x:Class="SegaEmulator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="{DynamicResource Title_Settings}" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PrimaryBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Window.Resources>
        <!-- Combobox Style for Dark Theme -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,4,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          Background="{TemplateBinding Background}" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Path x:Name="Arrow" Fill="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L4,4 L8,0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Template="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Focusable="True" Background="Transparent" Foreground="{TemplateBinding Foreground}" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{StaticResource SurfaceBgBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                    <ScrollViewer Margin="0,2,0,2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>
        <!-- Checkbox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0" Margin="16">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Padding="12,8" Margin="0,0,4,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource SegaBlueBrightBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Style>
            </TabControl.Resources>

            <!-- 1. Çekirdek Sekmesi -->
            <TabItem Header="{DynamicResource Tab_Core}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="{DynamicResource Header_Core}" Style="{StaticResource HeaderStyle}"/>
                        
                        <Grid Margin="0,16,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Header_SegaCdBios}" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" Margin="0"/>
                            <Button Grid.Column="1" Content="{DynamicResource Btn_Upload}" Command="{Binding UploadBiosCommand}" Style="{StaticResource AccentButton}" Padding="12,4" Margin="0,0,8,0"
                                      Visibility="{Binding IsUploadBiosVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Grid.Column="2" Content="🗑️" Command="{Binding DeleteAllBiosCommand}" Style="{StaticResource ToolbarButton}" Padding="4" ToolTip="Tüm BIOS Dosyalarını Sil"
                                      Visibility="{Binding IsAnyBiosPresent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="USA (bios_CD_U.bin):" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Text_Loaded}" Foreground="#4CAF50" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" Visibility="{Binding IsBiosUPresent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Text_Missing}" Foreground="#F44336" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" Visibility="{Binding IsBiosUPresent, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}"/>
                        </Grid>

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Europe (bios_CD_E.bin):" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Text_Loaded}" Foreground="#4CAF50" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" Visibility="{Binding IsBiosEPresent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Text_Missing}" Foreground="#F44336" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" Visibility="{Binding IsBiosEPresent, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}"/>
                        </Grid>

                        <Grid Margin="0,4,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Japan (bios_CD_J.bin):" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Text_Loaded}" Foreground="#4CAF50" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" Visibility="{Binding IsBiosJPresent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Text_Missing}" Foreground="#F44336" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" Visibility="{Binding IsBiosJPresent, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}"/>
                        </Grid>

                        <CheckBox Content="{DynamicResource Chk_ShowFps}" IsChecked="{Binding ShowFps}"/>

                        <TextBlock Text="{DynamicResource Lbl_AudioSamplerate}" Style="{StaticResource LabelStyle}" Margin="0,12,0,4"/>
                        <ComboBox SelectedValue="{Binding AudioSamplerate}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{DynamicResource Combo_Audio_22}" Tag="22050"/>
                            <ComboBoxItem Content="{DynamicResource Combo_Audio_44}" Tag="44100"/>
                            <ComboBoxItem Content="{DynamicResource Combo_Audio_48}" Tag="48000"/>
                        </ComboBox>
                        
                        <TextBlock Text="{DynamicResource Lbl_Ym2612}" Style="{StaticResource LabelStyle}"/>
                        <ComboBox SelectedValue="{Binding Ym2612Emulation}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{DynamicResource Combo_Ym_Fast}" Tag="mame"/>
                            <ComboBoxItem Content="{DynamicResource Combo_Ym_High}" Tag="nuked"/>
                        </ComboBox>
                        
                        <CheckBox Content="{DynamicResource Chk_SixButton}" IsChecked="{Binding SixButtonAuto}"/>
                        <CheckBox Content="{DynamicResource Chk_SvpSupport}" IsChecked="{Binding SvpSupport}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Video Ayarları Sekmesi -->
            <TabItem Header="{DynamicResource Tab_Video}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="{DynamicResource Header_Video}" Style="{StaticResource HeaderStyle}"/>
                        
                        <TextBlock Text="{DynamicResource Lbl_ScreenFilter}" Style="{StaticResource LabelStyle}"/>
                        <ComboBox SelectedValue="{Binding ScreenFilter}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{DynamicResource Combo_Filter_Off}" Tag="None"/>
                            <ComboBoxItem Content="{DynamicResource Combo_Filter_Crt}" Tag="CRT"/>
                            <ComboBoxItem Content="{DynamicResource Combo_Filter_Lcd}" Tag="LCD"/>
                        </ComboBox>
                        
                        <CheckBox Content="{DynamicResource Chk_TubeTv}" IsChecked="{Binding TubeTvEffectEnabled}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. Kontroller Sekmesi -->
            <TabItem Header="{DynamicResource Tab_Controls}">
                <Grid Margin="0,20,0,0" DataContext="{Binding ControlsVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="{DynamicResource Text_ControlsInfo}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                    
                    <TabControl Grid.Row="1" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <TabItem Header="{DynamicResource Tab_Player1}">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Player1Bindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{Binding BoundKey}" Click="AssignButton_Click" Tag="{Binding}" Style="{StaticResource AccentButton}" Padding="4" HorizontalAlignment="Left" Width="100"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="{DynamicResource Tab_Player2}">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Player2Bindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{Binding BoundKey}" Click="AssignButton_Click" Tag="{Binding}" Style="{StaticResource AccentButton}" Padding="4" HorizontalAlignment="Left" Width="100"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- 4. Hakkında Sekmesi -->
            <TabItem Header="{DynamicResource Tab_About}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="80" Height="80" CornerRadius="16" Margin="0,0,0,16" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/hedgehog.png" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{DynamicResource App_Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Text_VersionInfo}" Foreground="{StaticResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,24"/>
                    
                    <TextBlock Text="{DynamicResource Text_CoreInfo}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,2"/>
                    <TextBlock Text="{DynamicResource App_Subtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,2"/>
                    <TextBlock Text="{DynamicResource Text_DevInfo}" Foreground="{StaticResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,16"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Btn_Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0" Padding="20,6"/>
                <Button Content="{DynamicResource Btn_Save}" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" Padding="24,6"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
