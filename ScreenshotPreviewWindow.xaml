<Window x:Class="SegaEmulator.Views.ScreenshotPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Title_ScreenshotPreview}" 
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBgBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preview Image -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="Black" Margin="0,0,0,14" CornerRadius="4">
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <!-- Save Path Info -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Lbl_SavePath}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" FontSize="12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathTextBox" IsReadOnly="True"
                         Background="{StaticResource SurfaceBgBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Padding="8,5" FontSize="11"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="{DynamicResource Btn_Change}" 
                        Style="{StaticResource ToolbarButton}" 
                        Margin="8,0,0,0" Padding="12,5"
                        Click="ChangeBtn_Click"/>
            </Grid>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button x:Name="CancelBtn" Content="{DynamicResource Btn_Cancel}"
                    Style="{StaticResource ToolbarButton}" Width="90" Margin="0,0,10,0" Padding="5,7"
                    Click="CancelBtn_Click"/>
            <Button x:Name="SaveBtn" Content="{DynamicResource Btn_Save}"
                    Style="{StaticResource AccentButton}" Width="90" Padding="5,7"
                    Click="SaveBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>

