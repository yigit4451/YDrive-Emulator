<Window x:Class="SegaEmulator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SegaEmulator.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource App_Title}" Height="720" Width="1100"
        MinWidth="800" MinHeight="600"
        Style="{StaticResource EmulatorWindow}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Üst Menü -->
            <RowDefinition Height="Auto"/> <!-- Header / Araç Çubuğu -->
            <RowDefinition Height="*"/>    <!-- Kütüphane Kart Alanı -->
            <RowDefinition Height="Auto"/> <!-- Alt Durum Çubuğu -->
        </Grid.RowDefinitions>

        <!-- 1. Menü Çubuğu -->
        <Menu Grid.Row="0">
            <MenuItem Header="{DynamicResource Menu_File}">
                <MenuItem Header="{DynamicResource Menu_AddRom}" Command="{Binding AddRomCommand}" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_Settings}" Command="{Binding OpenSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_Exit}" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu_View}">
                <MenuItem Header="{DynamicResource Menu_GridMode}" Command="{Binding SetGridViewCommand}"/>
                <MenuItem Header="{DynamicResource Menu_ListMode}" Command="{Binding SetListViewCommand}"/>
            </MenuItem>
        </Menu>

        <!-- 2. Header & Araç Çubuğu -->
        <Border Grid.Row="1" Background="{StaticResource SecondaryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Logo / Başlık -->
                    <ColumnDefinition Width="*"/>    <!-- Arama Çubuğu -->
                    <ColumnDefinition Width="Auto"/> <!-- Butonlar -->
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/hedgehog.png" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YDrive" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource App_Subtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Arama Çubuğu -->
                <Border x:Name="SearchBorder" Grid.Column="1" Background="{StaticResource PrimaryBgBrush}" BorderThickness="1" CornerRadius="6" Height="36" VerticalAlignment="Center" Margin="0,0,16,0" Padding="10,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource SegaBlueBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <!-- Placeholder (Watermark) -->
                            <TextBlock Text="{DynamicResource Text_SearchPlaceholder}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=SearchTextBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            
                            <!-- Gerçek Arama Kutusu -->
                            <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" 
                                     CaretBrush="White" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Sağ Buton Grubu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Btn_Settings}" Command="{Binding OpenSettingsCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0" Padding="14,6"/>
                    <Button Content="{DynamicResource Btn_AddRom}" Command="{Binding AddRomCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Padding="14,6"/>

                    <!-- Görünüm Değiştirici (Grid / Liste) -->
                    <Border Background="{StaticResource PrimaryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource Btn_Grid}" IsChecked="{Binding IsGridView, Mode=TwoWay}" Style="{StaticResource ViewToggleRadioButtonStyle}"/>
                            <RadioButton Content="{DynamicResource Btn_List}" IsChecked="{Binding IsListView, Mode=TwoWay}" Style="{StaticResource ViewToggleRadioButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Kütüphane İçeriği -->
        <Grid Grid.Row="2" Margin="16">

            <!-- 3A. GRID GÖRÜNÜMÜ (Kartlar) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding FilteredGames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Oyun Kartı -->
                            <Border Margin="6" Width="160" Height="220"
                                    Background="{StaticResource SecondaryBgBrush}" 
                                    BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    ClipToBounds="True"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding LaunchCommand}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SegaBlueBrightBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>    <!-- Cover Image -->
                                        <RowDefinition Height="Auto"/> <!-- Details -->
                                    </Grid.RowDefinitions>

                                    <!-- Kapak Resmi (Artwork) / Placeholder -->
                                    <Grid Grid.Row="0" Background="{StaticResource PrimaryBgBrush}" Height="160">
                                        <Image Source="{Binding CoverImagePath, Converter={StaticResource FilePathToImageConverter}}" Stretch="UniformToFill" 
                                               Visibility="{Binding CoverImagePath, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"/>

                                        <Border Visibility="{Binding CoverImagePath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}" 
                                                Background="{StaticResource SegaBlueGradient}" CornerRadius="6" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="pack://application:,,,/Assets/hedgehog.png" Stretch="UniformToFill" Opacity="0.6"/>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding ConsoleName}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- System Badge -->
                                        <Border Background="{Binding SystemBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                            <TextBlock Text="{Binding SystemBadgeText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Sağ Üst Üç Nokta (...) Menü Butonu -->
                                        <Button Style="{StaticResource OverflowButtonStyle}" 
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Top" 
                                                Margin="8"
                                                Click="OverflowButton_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource CardContextMenuStyle}">
                                                    <MenuItem Header="{DynamicResource Ctx_Start}" Command="{Binding LaunchCommand}" FontWeight="Bold"/>
                                                    <MenuItem Header="{DynamicResource Ctx_Rename}" Command="{Binding RenameCommand}"/>
                                                    <MenuItem Header="{DynamicResource Ctx_ChangeCover}" Command="{Binding ChangeCoverCommand}"/>
                                                    <MenuItem Header="{DynamicResource Ctx_RemoveCover}" Command="{Binding RemoveCoverCommand}" Visibility="{Binding HasCoverImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <MenuItem Header="{DynamicResource Ctx_Rescrape}" Command="{Binding RescrapeCommand}"/>
                                                    <MenuItem Header="{DynamicResource Ctx_ShowAbout}" Command="{Binding ShowAboutCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{DynamicResource Ctx_Delete}" Command="{Binding DeleteCommand}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>

                                    <!-- Alt Kart Bilgisi -->
                                    <Border Grid.Row="1" Padding="10,8" Background="{StaticResource SecondaryBgBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                                       FontWeight="Bold" 
                                                       FontSize="12" 
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ConsoleName}" 
                                                       Foreground="{StaticResource TextMutedBrush}" 
                                                       FontSize="10" 
                                                       Margin="0,2,0,0" 
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3B. LİSTE GÖRÜNÜMÜ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}">
                <ItemsControl ItemsSource="{Binding FilteredGames}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Liste Öğesi -->
                            <Border Margin="0,0,0,8" Padding="12,10"
                                    Background="{StaticResource SecondaryBgBrush}" 
                                    BorderBrush="{StaticResource BorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="8"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding LaunchCommand}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SegaBlueBrightBrush}"/>
                                                <Setter Property="Background" Value="{StaticResource SurfaceBgBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- İkon -->
                                        <ColumnDefinition Width="*"/>    <!-- Başlık & Konsol -->
                                        <ColumnDefinition Width="150"/>  <!-- Yapımcı -->
                                        <ColumnDefinition Width="100"/>  <!-- Yıl -->
                                        <ColumnDefinition Width="Auto"/> <!-- Menü (...) -->
                                    </Grid.ColumnDefinitions>

                                    <!-- İkon / Kapak -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True">
                                        <Grid>
                                             <Image Source="{Binding CoverImagePath, Converter={StaticResource FilePathToImageConverter}}" Stretch="UniformToFill" 
                                                    Visibility="{Binding CoverImagePath, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                             <Image Source="pack://application:,,,/Assets/hedgehog.png" Stretch="UniformToFill"
                                                    Visibility="{Binding CoverImagePath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Başlık & Konsol -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                                        <!-- System Badge -->
                                        <Border Background="{Binding SystemBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding SystemBadgeText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Yapımcı -->
                                    <TextBlock Grid.Column="2" Text="{Binding Developer}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>

                                    <!-- Yıl -->
                                    <TextBlock Grid.Column="3" Text="{Binding ReleaseYear}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>

                                    <!-- Sağ Üst Menü Butonu (...) -->
                                    <Button Grid.Column="4" Style="{StaticResource OverflowButtonStyle}" VerticalAlignment="Center" Click="OverflowButton_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource CardContextMenuStyle}">
                                                <MenuItem Header="▶ Başlat" Command="{Binding LaunchCommand}" FontWeight="Bold"/>
                                                <MenuItem Header="✏ Yeniden Adlandır" Command="{Binding RenameCommand}"/>
                                                <MenuItem Header="🖼 Kapak Resmini Değiştir..." Command="{Binding ChangeCoverCommand}"/>
                                                <MenuItem Header="❌ Kapak Resmini Kaldır" Command="{Binding RemoveCoverCommand}" Visibility="{Binding HasCoverImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <MenuItem Header="🔄 Bilgileri İnternetten Yenile" Command="{Binding RescrapeCommand}"/>
                                                <MenuItem Header="ℹ Oyun Hakkında" Command="{Binding ShowAboutCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="🗑 Kütüphaneden Sil" Command="{Binding DeleteCommand}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3C. BOŞ KÜTÜPHANE / BULUNAMADI UYARISI -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasGames, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}">
                <TextBlock Text="📂" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{DynamicResource Text_EmptyTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Text_EmptyDesc}" 
                           Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,8,0,20" HorizontalAlignment="Center"/>
                <Button Content="{DynamicResource Btn_SelectRom}" Command="{Binding AddRomCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Padding="16,8"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmptySearchResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{DynamicResource Text_EmptySearch}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>

        <!-- 4. Alt Durum Çubuğu -->
        <Border Grid.Row="3" Style="{StaticResource AppStatusBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Text_StatusBarVersion}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Text_Library}" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Games.Count}" Foreground="{StaticResource SegaBlueBrightBrush}" FontWeight="Bold"/>
                    <TextBlock Text="{DynamicResource Text_GamesCount}" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
