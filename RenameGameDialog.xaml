<Window x:Class="SegaEmulator.Views.RenameGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource Title_Rename}" Height="220" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource EmulatorWindow}">

    <Border Padding="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Lbl_NewName}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
            
            <TextBox x:Name="TitleTextBox" 
                     Style="{StaticResource SearchTextBoxStyle}" 
                     Height="40" 
                     FontSize="14"
                     Padding="8,4,8,4"
                     Foreground="White"
                     Background="#252526"
                     VerticalContentAlignment="Center" 
                     Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Btn_Cancel}" Click="Cancel_Click" Style="{StaticResource ToolbarButton}" Width="80" Margin="0,0,10,0"/>
                <Button Content="{DynamicResource Btn_Save}" Click="Save_Click" Style="{StaticResource AccentButton}" Width="90" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
