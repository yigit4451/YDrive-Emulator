<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:YDrive.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="YDrive.Views.GameDetailsView"
             x:DataType="vm:GameItemViewModel">
    <Grid Margin="20" ColumnDefinitions="Auto,*">
        <!-- Kapak Resmi -->
        <Border Grid.Column="0" Width="200" Height="280" CornerRadius="8" ClipToBounds="True" Background="#313244">
            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
        </Border>
        
        <!-- Oyun Bilgileri -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="10">
            <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="Bold" Foreground="White" />
            <TextBlock Text="{Binding ConsoleName}" FontSize="18" Foreground="#A6ADC8" />
            
            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto" Margin="0,20,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Geliştirici:" Foreground="#6C7086" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Developer}" Foreground="White" />
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Çıkış Yılı:" Foreground="#6C7086" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReleaseDate}" Foreground="White" Margin="0,10,0,0"/>
            </Grid>
            
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,30,0,0">
                <Button Content="Oyunu Başlat" Command="{Binding LaunchCommand}" Background="#A6E3A1" Foreground="Black" FontWeight="Bold" Padding="20,10" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
