<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:YDrive.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="YDrive.Views.GameWindowView"
             x:DataType="vm:GameWindowViewModel"
             UseLayoutRounding="True"
             RenderOptions.TextRenderingMode="SubpixelAntialias"
             RenderOptions.EdgeMode="Antialias"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             TextElement.FontFamily="avares://YDrive/Assets/Fonts#Roboto, Segoe UI, sans-serif"
             Focusable="True" Background="Black"
             FocusAdorner="{x:Null}"
             Loaded="Control_OnLoaded">

    <UserControl.Styles>
        <!-- SEGA Genesis 6-Button Arcade Style Action Buttons (Uniform 68x68dp) -->
        <Style Selector="Border.TouchBtnA, Border.TouchBtnB, Border.TouchBtnC">
            <Setter Property="Background" Value="#660047AB"/>
            <Setter Property="BorderBrush" Value="#CC64B5F6"/>
            <Setter Property="CornerRadius" Value="34"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- SEGA Genesis Upper Row Buttons (Uniform 52x52px) -->
        <Style Selector="Border.TouchBtnXYZ">
            <Setter Property="Background" Value="#550047AB"/>
            <Setter Property="BorderBrush" Value="#9964B5F6"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Start Button -->
        <Style Selector="Border.TouchBtnStart">
            <Setter Property="Background" Value="#66212121"/>
            <Setter Property="BorderBrush" Value="#99E0E0E0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- Edit Mode Highlighting -->
        <Style Selector="Border.EditMode">
            <Setter Property="BorderBrush" Value="#4D7DC3"/>
            <Setter Property="Background" Value="#80A8C7FA"/>
        </Style>

        <Style Selector="Border.DPad, Border.TouchBtnA, Border.TouchBtnB, Border.TouchBtnC, Border.TouchBtnXYZ, Border.TouchBtnStart">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>

        <!-- Frosted Glass D-Pad Base (160x160dp) -->
        <Style Selector="Border.DPad">
            <Setter Property="Background" Value="#7012131A"/>
            <Setter Property="CornerRadius" Value="80"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#50A8C7FA"/>
        </Style>
        <Style Selector="Border.DPad.EditMode">
            <Setter Property="BorderBrush" Value="#4D7DC3"/>
            <Setter Property="Background" Value="#80A8C7FA"/>
        </Style>

        <!-- Top Bar Icon Buttons (44x44dp) -->
        <Style Selector="Button.TopBarIconBtn">
            <Setter Property="Background" Value="#2B2930"/>
            <Setter Property="Foreground" Value="#E6E1E5"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.TopBarIconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4458"/>
        </Style>

        <Style Selector="Button.TopBarIconBtnDanger">
            <Setter Property="Background" Value="#601410"/>
            <Setter Property="Foreground" Value="#FFB4AB"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.TopBarIconBtnDanger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#8C1D18"/>
        </Style>

        <!-- Ghost / Text Buttons -->
        <Style Selector="Button.Ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4D7DC3"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.Ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2B2930"/>
        </Style>

        <!-- Save / Load Modal Animations -->
        <Style Selector="Panel.SaveModal">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransform" Value="translateY(200px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.SaveModal.open">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- 1. Game Renderer Area (60 FPS Video Stream) -->
        <Border Background="Black" ZIndex="0">
            <Image x:Name="ScreenImage"
                   Source="{Binding ScreenBitmap}"
                   Stretch="{Binding GameStretch}"
                   RenderOptions.BitmapInterpolationMode="None"/>
        </Border>

        <!-- FPS Counter -->
        <Border ZIndex="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Background="#80000000" CornerRadius="8" IsVisible="{Binding ShowFps}" IsHitTestVisible="False">
            <TextBlock Text="{Binding FpsText}" Foreground="#00FF00" FontSize="16" FontWeight="Bold" Padding="8,4" />
        </Border>

        <!-- 2. Touch Controls Overlay -->
        <Canvas x:Name="TouchCanvas" ZIndex="10"
                IsVisible="{Binding IsTouchControlsEnabled}"
                Opacity="{Binding TouchOpacity}"
                Background="Transparent"
                SizeChanged="OnTouchCanvasSizeChanged"
                PointerPressed="OnCanvasPointerPressed"
                PointerMoved="OnCanvasPointerMoved"
                PointerReleased="OnCanvasPointerReleased">
            <Canvas.RenderTransform>
                <ScaleTransform ScaleX="{Binding TouchScale}" ScaleY="{Binding TouchScale}"/>
            </Canvas.RenderTransform>
            
            <!-- Sega Genesis D-Pad (160x160dp) -->
            <Border Classes="DPad" Classes.EditMode="{Binding IsEditMode}"
                    Width="160" Height="160"
                    Canvas.Left="{Binding TouchDPadX}"
                    Canvas.Top="{Binding TouchDPadY}"
                    Tag="DPad" Opacity="{Binding TouchDPadOpacity}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding TouchDPadScale}" ScaleY="{Binding TouchDPadScale}"/>
                </Border.RenderTransform>
                <Panel>
                    <!-- Center Thumb Hub -->
                    <Border Width="50" Height="50" CornerRadius="25" Background="#30FFFFFF"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"/>

                    <!-- Directional Arrows -->
                    <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*" IsHitTestVisible="False">
                        <!-- UP -->
                        <Path Fill="#F0F4F9" Data="M0,10 L10,0 L20,10 Z" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- LEFT (◄) -->
                        <Path Fill="#F0F4F9" Data="M10,0 L0,10 L10,20 Z" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- RIGHT (►) -->
                        <Path Fill="#F0F4F9" Data="M0,0 L10,10 L0,20 Z" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- DOWN -->
                        <Path Fill="#F0F4F9" Data="M0,0 L20,0 L10,10 Z" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Panel>
            </Border>

            <!-- Lower Arc: SEGA Main Action Buttons (Uniform 68x68px) -->
            <Border Classes="TouchBtnA" Classes.EditMode="{Binding IsEditMode}" Width="68" Height="68"
                    Canvas.Left="{Binding TouchAX}" Canvas.Top="{Binding TouchAY}"
                    Tag="A" Opacity="{Binding TouchAOpacity}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding TouchAScale}" ScaleY="{Binding TouchAScale}"/>
                </Border.RenderTransform>
                <TextBlock Text="A" Foreground="White" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Border>
            
            <Border Classes="TouchBtnB" Classes.EditMode="{Binding IsEditMode}" Width="68" Height="68"
                    Canvas.Left="{Binding TouchBX}" Canvas.Top="{Binding TouchBY}"
                    Tag="B" Opacity="{Binding TouchBOpacity}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding TouchBScale}" ScaleY="{Binding TouchBScale}"/>
                </Border.RenderTransform>
                <TextBlock Text="B" Foreground="White" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Border>
            
            <Border Classes="TouchBtnC" Classes.EditMode="{Binding IsEditMode}" Width="68" Height="68"
                    Canvas.Left="{Binding TouchCX}" Canvas.Top="{Binding TouchCY}"
                    Tag="C" Opacity="{Binding TouchCOpacity}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding TouchCScale}" ScaleY="{Binding TouchCScale}"/>
                </Border.RenderTransform>
                <TextBlock Text="C" Foreground="White" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Border>

            <!-- Upper Arc: SEGA 6-Button Row (Uniform 52x52px directly above A, B, C) -->
            <Border Classes="TouchBtnXYZ" Classes.EditMode="{Binding IsEditMode}" Width="52" Height="52"
                    Canvas.Left="{Binding TouchXX}" Canvas.Top="{Binding TouchXY}"
                    Tag="X" Opacity="{Binding TouchXOpacity}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding TouchXScale}" ScaleY="{Binding TouchXScale}"/>
                </Border.RenderTransform>
                <TextBlock Text="X" Foreground="#EDE7F6" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Border>
            
            <Border Classes="TouchBtnXYZ" Classes.EditMode="{Binding IsEditMode}" Width="52" Height="52"
                    Canvas.Left="{Binding TouchYX}" Canvas.Top="{Binding TouchYY}"
                    Tag="Y" Opacity="{Binding TouchYOpacity}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding TouchYScale}" ScaleY="{Binding TouchYScale}"/>
                </Border.RenderTransform>
                <TextBlock Text="Y" Foreground="#EDE7F6" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Border>
            
            <Border Classes="TouchBtnXYZ" Classes.EditMode="{Binding IsEditMode}" Width="52" Height="52"
                    Canvas.Left="{Binding TouchZX}" Canvas.Top="{Binding TouchZY}"
                    Tag="Z" Opacity="{Binding TouchZOpacity}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding TouchZScale}" ScaleY="{Binding TouchZScale}"/>
                </Border.RenderTransform>
                <TextBlock Text="Z" Foreground="#EDE7F6" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Border>
            
            <!-- Start Button -->
            <Border Classes="TouchBtnStart" Classes.EditMode="{Binding IsEditMode}" Width="80" Height="40"
                    Canvas.Left="{Binding TouchStartX}" Canvas.Top="{Binding TouchStartY}"
                    Tag="Start" Opacity="{Binding TouchStartOpacity}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding TouchStartScale}" ScaleY="{Binding TouchStartScale}"/>
                </Border.RenderTransform>
                <TextBlock Text="START" Foreground="#EEEEEE" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Border>
        </Canvas>

        <!-- 3. Edit Mode Overlay (Top Settings & Banner) -->
        <Panel ZIndex="20" IsVisible="{Binding IsEditMode}">
            
            <!-- Top Settings Panel (Opacity & Scale) -->
            <Border Background="#CC1D1B20" VerticalAlignment="Top" HorizontalAlignment="Center" CornerRadius="0,0,16,16" Padding="24,16" Margin="0,0,0,0" BorderBrush="#4D7DC3" BorderThickness="1,0,1,1">
                <StackPanel Spacing="12" Width="300">
                    <TextBlock Text="HUD Ayarları" FontWeight="Bold" Foreground="#4D7DC3" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Boyut" Foreground="#CAC4D0" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding TouchControlScale, StringFormat='{}{0:F1}x'}" Foreground="#E6E1E5" FontSize="14" VerticalAlignment="Center"/>
                    </Grid>
                    <Slider Minimum="0.6" Maximum="2.0" Value="{Binding TouchControlScale, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,-8,0,0"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Görünürlük" Foreground="#CAC4D0" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding TouchControlOpacity, StringFormat='{}{0:P0}'}" Foreground="#E6E1E5" FontSize="14" VerticalAlignment="Center"/>
                    </Grid>
                    <Slider Minimum="0.2" Maximum="1.0" Value="{Binding TouchControlOpacity, Mode=TwoWay}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,-8,0,0"/>
                    
                    <Button Classes="Primary" Content="Düzenlemeyi Bitir" Command="{Binding ToggleEditModeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </Panel>

        <!-- 4. Full-Width Top Bar (Tüm Üst Kenarı Kaplayan Bar) -->
        <Border ZIndex="30" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="#F0141218" BorderBrush="#333036" BorderThickness="0,0,0,1"
                Padding="16,8"
                IsVisible="{Binding IsTopBarVisible}"
                IsEnabled="{Binding !IsSaveLoadModalOpen}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Left: Game Title Badge with Gamepad Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#333036" CornerRadius="16" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Data="M15,9H13V7H11V9H9V11H11V13H13V11H15V9M19.5,4H4.5A2.5,2.5 0 0,0 2,6.5V17.5A2.5,2.5 0 0,0 4.5,20H19.5A2.5,2.5 0 0,0 22,17.5V6.5A2.5,2.5 0 0,0 19.5,4Z"
                                  Fill="#4D7DC3" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GameTitle}" FontWeight="Bold" FontSize="14" Foreground="#E6E1E5"
                                       VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Action Buttons Group -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    
                    <!-- 1. Screenshot (Ekran Görüntüsü Al & Galeriye Kaydet) -->
                    <Button x:Name="OverlayFirstButton" Classes="TopBarIconBtn" Command="{Binding TakeScreenshotCommand}" ToolTip.Tip="Ekran Görüntüsü Al (Galeriye Kaydet)">
                        <Path Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"
                              Fill="#4D7DC3" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- 2. Save / Load Slot Manager Modal -->
                    <Button Classes="TopBarIconBtn" Command="{Binding OpenSaveLoadModalCommand}" ToolTip.Tip="Kayıtlar (Save / Load Slotları)">
                        <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                              Fill="#4D7DC3" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- 3. Pause / Resume -->
                    <Button Classes="TopBarIconBtn" Command="{Binding TogglePauseCommand}" ToolTip.Tip="Duraklat / Devam Et">
                        <Panel Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M14,19H18V5H14M6,19H10V5H6V19Z"
                                  Fill="#E6E1E5" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding !IsPaused}"/>
                            <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                  Fill="#4D7DC3" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding IsPaused}"/>
                        </Panel>
                    </Button>



                    <!-- 5. Reset -->
                    <Button Classes="TopBarIconBtn" Command="{Binding ResetCommand}" ToolTip.Tip="Yeniden Başlat">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Fill="#E6E1E5" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- 6. Stop & Exit -->
                    <Button Classes="TopBarIconBtnDanger" Command="{Binding StopCommand}" ToolTip.Tip="Durdur ve Çık">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="#FFB4AB" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- 7. Close / Hide Top Bar (Yukarı Bakan Ok) -->
                    <Button Classes="TopBarIconBtn" Command="{Binding ToggleTopBarCommand}"
                            Background="#333036" ToolTip.Tip="Menüyü Gizle">
                        <Path Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"
                              Fill="#CAC4D0" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Floating Open Menu Trigger (Shown when top bar is collapsed - Aşağıya Bakan Ok) -->
        <Button ZIndex="30" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16,12,0,0"
                Classes="TopBarIconBtn" Command="{Binding ToggleTopBarCommand}"
                Background="#CC1D1B20" BorderBrush="#4A4458" BorderThickness="1"
                IsVisible="{Binding !IsTopBarVisible}"
                IsEnabled="{Binding !IsSaveLoadModalOpen}"
                ToolTip.Tip="Menüyü Aç">
            <Path Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                  Fill="#4D7DC3" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <!-- 5. SAVE / LOAD STATE FULLSCREEN OVERLAY (Kayıt Yöneticisi) -->
        <Panel ZIndex="100" Classes="SaveModal" Classes.open="{Binding IsSaveLoadModalOpen}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0">
            <Border Background="#F2131418"/>
            <Grid RowDefinitions="Auto,*">
                
                <!-- Top App Bar -->
                <Border Grid.Row="0" BorderBrush="#383540" BorderThickness="0,0,0,1" Background="#131418">
                    <Grid Height="56" ColumnDefinitions="Auto,*,Auto" Margin="8,0">
                        <!-- Back Button -->
                        <Button x:Name="SaveModalBackButton" Grid.Column="0" Command="{Binding CloseSaveLoadModalCommand}" 
                                Width="44" Height="44" CornerRadius="22" Background="Transparent" VerticalAlignment="Center">
                            <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" 
                                  Fill="#E6E1E5" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        
                        <!-- Title -->
                        <TextBlock Grid.Column="1" Text="Kayıt Yöneticisi (Save States)" FontSize="18" FontWeight="Bold" Foreground="#E6E1E5" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        
                        <!-- Add New Save State Button (➕ Butonu) -->
                        <Button Grid.Column="2" Command="{Binding CreateNewSaveCommand}"
                                Background="#0047AB" Foreground="#FFFFFF" CornerRadius="20" Height="40" Padding="16,0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                      Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Yeni Kayıt Al" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Dialog Content (Saves List) -->
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
                    <Panel>
                        <!-- Empty State Message -->
                        <StackPanel IsVisible="{Binding !HasSaveSlots}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="0,60">
                            <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                                  Fill="#607D8B" Opacity="0.7" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Henüz bu oyun için kaydedilmiş bir durum yok." Foreground="#CAC4D0" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock Text="Üstteki 'Yeni Kayıt Al' butonuna dokunarak oyunun istediğiniz yerini kaydedebilirsiniz." Foreground="#938F99" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
                        </StackPanel>

                        <!-- Populated Slots List -->
                        <ItemsControl ItemsSource="{Binding SaveSlots}" IsVisible="{Binding HasSaveSlots}"
                                 Background="Transparent" BorderThickness="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SaveSlotItem">
                                    <Border Background="#1F2128" CornerRadius="16" Padding="16,10" MinHeight="72" Margin="16,6" BorderBrush="#383540" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            
                                            <!-- Slot Icon -->
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#131418" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                                                      Fill="#2196F3" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Slot Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" Foreground="#E6E1E5"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding DateFormatted}" FontSize="12" Foreground="#CAC4D0"/>
                                                    <TextBlock Text="•" FontSize="12" Foreground="#4A4458"/>
                                                    <TextBlock Text="{Binding SizeFormatted}" FontSize="12" Foreground="#938F99"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Actions: Load / Overwrite / Delete -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                                
                                                <!-- Load State Button -->
                                                <Button Command="{Binding $parent[UserControl].DataContext.LoadSlotCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#1565C0" Foreground="#FFFFFF" CornerRadius="21" Height="42" Padding="16,0" FontWeight="SemiBold">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                                              Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Yükle" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Overwrite Save State Button -->
                                                <Button Command="{Binding $parent[UserControl].DataContext.OverwriteSlotCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#2D323E" Foreground="#FFFFFF" CornerRadius="21" Width="42" Height="42" Padding="0" Margin="6,0,0,0"
                                                        ToolTip.Tip="Üzerine Kaydet">
                                                    <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"
                                                          Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Delete State Button -->
                                                <Button Command="{Binding $parent[UserControl].DataContext.DeleteSlotCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#3D2024" Foreground="#FF5252" CornerRadius="21" Width="42" Height="42" Padding="0" Margin="6,0,0,0"
                                                        ToolTip.Tip="Kaydı Sil">
                                                    <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                          Fill="#FF5252" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </ScrollViewer>
            </Grid>
        </Panel>


    </Grid>
</UserControl>
