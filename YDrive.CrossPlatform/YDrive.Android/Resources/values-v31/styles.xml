<?xml version="1.0" encoding="utf-8" ?>
<resources>

  <!-- API 31+ uses the SplashScreen API -->
  <style name="MyTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
  </style>

  <style name="MyTheme.NoActionBar" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@null</item>
    <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    <item name="android:windowSplashScreenAnimationDuration">500</item>
    <item name="android:windowIsTranslucent">false</item>
  </style>

</resources>
