<Window x:Class="SegaEmulator.Views.GameDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SegaEmulator.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource Title_GameDetails}" Height="500" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource EmulatorWindow}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sol Taraf: Kapak Resmi (Artwork) - Code-Behind (CoverImage) -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="8" Background="{StaticResource SecondaryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True" Padding="4">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Kapak Fotoğrafı (Code-Behind Tarafından Doğrudan Yüklenir) -->
                    <Image x:Name="CoverImage" 
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <!-- Kapak Resmi Yoksa Modern Placeholder -->
                    <Border x:Name="PlaceholderBorder" Background="{StaticResource SegaBlueGradient}" Padding="16" CornerRadius="6"
                            Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,12" ClipToBounds="True">
                                <Image Source="pack://application:,,,/Assets/hedgehog.png" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Border Background="#40000000" CornerRadius="4" Padding="6,2" Margin="0,12,0,0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ConsoleName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Kapak Butonları -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Button Content="{DynamicResource Ctx_ChangeCover}" Click="ChangeCover_Click" Style="{StaticResource ToolbarButton}" Margin="0,0,0,6" HorizontalAlignment="Stretch" FontSize="11"/>
                <Button x:Name="RemoveCoverButton" Content="{DynamicResource Ctx_RemoveCover}" Click="RemoveCover_Click" Style="{StaticResource ToolbarButton}" Foreground="{StaticResource AccentRedBrush}" HorizontalAlignment="Stretch" FontSize="11" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- Sağ Taraf: Detay Bilgileri & Özet -->
        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Başlık ve Konsol Rozeti -->
                <RowDefinition Height="Auto"/> <!-- Detay Bilgileri Grid -->
                <RowDefinition Height="*"/>    <!-- Oyun Özeti (Summary) -->
                <RowDefinition Height="Auto"/> <!-- Aksiyon Butonları -->
            </Grid.RowDefinitions>

            <!-- Başlık ve Konsol Rozeti -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Background="{StaticResource SegaBlueBrush}" CornerRadius="4" Padding="10,4">
                        <TextBlock Text="{Binding ConsoleName}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Detay Alanı Grid -->
            <Grid Grid.Row="1" Margin="0,16,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Geliştirici -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Lbl_Developer}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Developer}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>

                <!-- Dinamik Çıkış Yılı -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Lbl_ReleaseYear}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReleaseYear}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>

                <!-- ROM Durumu -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Lbl_RomStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRomFile}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding RomPath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Oyun Özeti Section -->
            <Border Grid.Row="2" Background="{StaticResource SecondaryBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Lbl_Description}" Foreground="{StaticResource SegaBlueBrightBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Alt Aksiyon Butonları -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Ctx_Rescrape}" Command="{Binding RescrapeCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,12,0"/>
                <Button Content="{DynamicResource Ctx_Start}" Click="Launch_Click" Style="{StaticResource AccentButton}" Margin="0,0,12,0"/>
                <Button Content="{DynamicResource Btn_Close}" Click="Close_Click" Style="{StaticResource ToolbarButton}" Width="100"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
