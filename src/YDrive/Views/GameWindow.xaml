<Window x:Class="SegaEmulator.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SegaEmulator.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title, FallbackValue='YDrive - GameWindow'}"
        Width="700" Height="580"
        MinWidth="640" MinHeight="480"
        Style="{StaticResource EmulatorWindow}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Emülasyon Araç Çubuğu -->
            <RowDefinition Height="*"/>    <!-- Ekran -->
            <RowDefinition Height="Auto"/> <!-- Durum Çubuğu -->
        </Grid.RowDefinitions>

        <!-- Araç Çubuğu (Toolbar) -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding IsNotFullscreen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- Butonlar daha az yer kaplasın diye Padding, Margin ve FontSize düşürüldü -->
                    <Button Content="{Binding PauseButtonText}" Command="{Binding PauseResumeCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,4,0" Padding="8,4" FontSize="12" Focusable="False"/>
                    <Button Content="{DynamicResource Btn_Reset}" Command="{Binding ResetCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,4,0" Padding="8,4" FontSize="12" Focusable="False"/>
                    <Button Content="{DynamicResource Btn_SaveState}" Command="{Binding SaveStateCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,4,0" Padding="8,4" FontSize="12" Focusable="False"/>
                    <Button Content="{DynamicResource Btn_LoadState}" Command="{Binding LoadStateCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,4,0" Padding="8,4" FontSize="12" Focusable="False"/>
                    <Button Content="{DynamicResource Btn_Screenshot}" Command="{Binding TakeScreenshotCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,4,0" Padding="8,4" FontSize="12" Focusable="False"/>
                    <Button Content="{Binding FullscreenIcon}" Command="{Binding ToggleFullscreenCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,0,0" Padding="8,4" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Ekran (Merkez Render Alanı) -->
        <Border Grid.Row="1" Background="Black">
            <Grid>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Border Style="{StaticResource ScreenBorder}">
                        <Grid>
                            <Image Source="{Binding ScreenImage}" 
                                   Width="{Binding ScreenWidth}" 
                                   Height="{Binding ScreenHeight}"
                                   RenderOptions.BitmapScalingMode="{Binding ScalingMode}"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        
                            <!-- CRT Filter Overlay (Scanlines) -->
                            <Rectangle Visibility="{Binding CrtFilterVisibility}" IsHitTestVisible="False" Width="{Binding ScreenWidth}" Height="{Binding ScreenHeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.30">
                                <Rectangle.CacheMode>
                                    <BitmapCache RenderAtScale="1.0" EnableClearType="False" SnapsToDevicePixels="True"/>
                                </Rectangle.CacheMode>
                                <Rectangle.Fill>
                                    <DrawingBrush Viewport="0,0,1,3" ViewportUnits="Absolute" TileMode="Tile" Stretch="None">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="Black">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,1,1"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            
                            <!-- LCD Grid Filter Overlay -->
                            <Rectangle Visibility="{Binding LcdFilterVisibility}" IsHitTestVisible="False" Width="{Binding ScreenWidth}" Height="{Binding ScreenHeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3">
                                <Rectangle.CacheMode>
                                    <BitmapCache RenderAtScale="1.0" EnableClearType="False" SnapsToDevicePixels="True"/>
                                </Rectangle.CacheMode>
                                <Rectangle.Fill>
                                    <DrawingBrush Viewport="0,0,3,3" ViewportUnits="Absolute" TileMode="Tile" Stretch="None">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="Black">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <LineGeometry StartPoint="0,0" EndPoint="3,0"/>
                                                        <LineGeometry StartPoint="0,0" EndPoint="0,3"/>
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <!-- 3D Tube TV Overlay (Vignette, Curved Bezel, Glass Reflection) -->
                            <Grid Visibility="{Binding TubeTvFilterVisibility}" IsHitTestVisible="False" Width="{Binding ScreenWidth}" Height="{Binding ScreenHeight}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.CacheMode>
                                    <BitmapCache RenderAtScale="1.0" EnableClearType="False" SnapsToDevicePixels="True"/>
                                </Grid.CacheMode>
                                <!-- Vignette / Bulge Shadow Effect -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.75">
                                            <GradientStop Color="#00000000" Offset="0.5" />
                                            <GradientStop Color="#AA000000" Offset="0.95" />
                                            <GradientStop Color="#FF000000" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                
                                <!-- Curved Bezel (cuts off the sharp corners) -->
                                <Border BorderBrush="Black" BorderThickness="20" CornerRadius="60"/>
                                
                                <!-- Subtle Glass Reflection -->
                                <Rectangle Margin="20" Opacity="0.06">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0.0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.4"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- Yükleniyor / Durduruldu Mesajı -->
                <TextBlock Text="{DynamicResource Text_GamePaused}" 
                           Foreground="{StaticResource TextMutedBrush}" 
                           FontSize="18" 
                           TextAlignment="Center" 
                           VerticalAlignment="Center"
                           Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}"/>

                <!-- Ekran İçi FPS (YALNIZCA Tam Ekran İçin) -->
                <TextBlock Text="{Binding FpsText}" 
                           Foreground="{StaticResource AccentGreenBrush}" 
                           FontWeight="Bold" 
                           FontSize="18"
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Bottom" 
                           Margin="0,0,16,16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="2" Color="Black"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FpsText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Tam Ekran Bilgi Mesajı (Popup) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                        Margin="16,16,0,0" Background="#99000000" 
                        CornerRadius="6" Padding="12,8" IsHitTestVisible="False"
                        Opacity="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="PopupStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:3.0" Duration="0:0:0.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="PopupStoryboard"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ" Foreground="{StaticResource SegaBlueBrightBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Text_ExitFullscreenInfo}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Sistem Bildirimi (Popup) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                        Margin="16,16,0,0" Background="#99000000" 
                        CornerRadius="6" Padding="12,8" IsHitTestVisible="False"
                        Opacity="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNotificationVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="SysPopupStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ" Foreground="{StaticResource SegaBlueBrightBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding NotificationText}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Durum Çubuğu -->
        <Border Grid.Row="2" Style="{StaticResource AppStatusBarStyle}"
                Visibility="{Binding IsNotFullscreen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding StatusColor}"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding FpsText}" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" Width="60" TextAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
